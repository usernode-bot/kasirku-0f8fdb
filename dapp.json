{
  "description": "A simple cashier app for your shop's sales",
  "icon": {
    "image": "brand/icon.png",
    "emoji": "🧾"
  },
  "secrets": [],
  "permissions": [{ "capability": "camera", "reason": "Memindai barcode produk di Kasir" }],
  "visibility": {
    "build": "public",
    "view": "public"
  },
  "tests": [
    {
      "id": "store.first",
      "name": "A new owner is asked to create their first store",
      "path": "/",
      "expectText": "Belum ada toko",
      "visual": true,
      "impact": [
        "public/**",
        "api.js",
        "server.js",
        "styles/**"
      ]
    },
    {
      "id": "store.onboarding",
      "name": "The first-store screen shows the starter steps checklist",
      "path": "/",
      "expectText": "Langkah awal",
      "impact": [
        "public/**",
        "api.js",
        "styles/**"
      ]
    },
    {
      "id": "store.sample",
      "name": "The first-store screen offers example data",
      "path": "/",
      "expectText": "Coba dengan data contoh",
      "impact": [
        "public/**",
        "api.js"
      ]
    },
    {
      "id": "stok.inventory",
      "name": "Stock tab without a store shows the first-store screen",
      "path": "/#stok",
      "expectText": "Belum ada toko"
    },
    {
      "id": "laporan.daily",
      "name": "Report tab without a store shows the first-store screen",
      "path": "/#laporan",
      "expectText": "Belum ada toko"
    },
    {
      "id": "kasir.credit-method",
      "name": "Kasir offers Bayar nanti",
      "path": "/",
      "expectSelector": "#pay-methods [data-method=\"credit\"]",
      "impact": [
        "public/**",
        "api.js",
        "styles/**"
      ]
    },
    {
      "id": "kasir.search",
      "name": "Kasir has a product search box above the product list",
      "path": "/",
      "expectSelector": "#pos-search"
    },
    {
      "id": "kasir.scan",
      "name": "Kasir has the barcode scan control",
      "path": "/",
      "expectSelector": "#dlg-scan",
      "impact": [
        "public/**",
        "styles/**"
      ]
    },
    {
      "id": "insights.empty",
      "name": "Insights answer honestly for a visitor without a store",
      "path": "/api/insights",
      "expectText": "\"shopping\":[]"
    }
  ]
}
