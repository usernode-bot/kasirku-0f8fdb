{
  "description": "A simple cashier app for your shop's sales",
  "icon": {
    "image": "brand/icon.png",
    "emoji": "🧾"
  },
  "secrets": [],
  "visibility": {
    "build": "public",
    "view": "public"
  },
  "tests": [
    {
      "id": "store.first",
      "name": "A new owner is asked to create their first store",
      "path": "/",
      "expectText": "Belum ada toko",
      "visual": true,
      "impact": [
        "public/**",
        "api.js",
        "server.js",
        "styles/**"
      ]
    },
    {
      "id": "store.onboarding",
      "name": "The first-store screen shows the starter steps checklist",
      "path": "/",
      "expectText": "Langkah awal",
      "impact": [
        "public/**",
        "api.js",
        "styles/**"
      ]
    },
    {
      "id": "stok.inventory",
      "name": "Stock tab without a store shows the first-store screen",
      "path": "/#stok",
      "expectText": "Belum ada toko"
    },
    {
      "id": "laporan.daily",
      "name": "Report tab without a store shows the first-store screen",
      "path": "/#laporan",
      "expectText": "Belum ada toko"
    },
    {
      "id": "kasir.debt-method",
      "name": "Checkout offers Utang with a customer name field",
      "path": "/",
      "expectSelector": "#pay-methods [data-method=debt]"
    },
    {
      "id": "kasir.receipt-whatsapp",
      "name": "The receipt can be sent through WhatsApp",
      "path": "/",
      "expectSelector": "#dlg-receipt #receipt-wa-send"
    },
    {
      "id": "offline.sw",
      "name": "The app ships a service worker so it opens offline",
      "path": "/sw.js",
      "expectText": "kasirku-shell"
    }
  ]
}
